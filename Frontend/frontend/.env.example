# ---- Frontend environment (copy to .env for local development) ----
# Base URL of the FastAPI backend (uploads, reports, history, dashboard, health).
VITE_API_BASE_URL=http://localhost:8000

# NOTE: there is intentionally no ML engine variable. The frontend never calls
# the ML assurance engine directly — the architecture is Frontend → Backend →
# ML, and the ML API exposes no CORS headers for browser access.
#
# Never put secrets (AWS / MongoDB / Bedrock / LLM keys) in this file: values
# here are compiled into the public browser bundle.
